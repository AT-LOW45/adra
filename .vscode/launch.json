// A launch configuration that compiles the extension and then opens it inside a new window
// Use IntelliSense to learn about possible attributes.
// Hover to view descriptions of existing attributes.
// For more information, visit: https://go.microsoft.com/fwlink/?linkid=830387
{
	"version": "0.2.0",
	"configurations": [
		{
			"name": "Run Extension",
			"type": "extensionHost",
			"request": "launch",
			"args": [
				"--extensionDevelopmentPath=${workspaceFolder}",
				// These two scan for pyenv/poetry/pipenv/conda — none of which are installed —
				// and every failed probe throws a caught exception that halts the debugger.
				// Python + Pylance stay enabled, so import fixes still work.
				"--disable-extension=donjayamanne.python-environment-manager",
				"--disable-extension=ms-python.vscode-python-envs"
			],
			"outFiles": [
				"${workspaceFolder}/out/**/*.js"
			],
			"skipFiles": [
				"<node_internals>/**",
				"**/node_modules/**"
			],
			"preLaunchTask": "${defaultBuildTask}"
		}
	]
}
