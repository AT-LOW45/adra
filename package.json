{
	"name": "adra",
	"displayName": "Adra",
	"repository": {
		"type": "git",
		"url": "https://github.com/AT-LOW45/adra.git"
	},
	"description": "RAG based code completion to enforce org wide standards",
	"version": "0.0.1",
	"engines": {
		"vscode": "^1.120.0"
	},
	"categories": [
		"AI",
		"Programming Languages",
		"Snippets"
	],
	"activationEvents": [
		"*"
	],
	"main": "./out/main.js",
	"contributes": {
		"configuration": {
			"properties": {
				"adra.ragEndpoint": {
					"type": "string",
					"default": "http://127.0.0.1:8000",
					"description": "URL of the RAG server"
				}
			}
		},
		"commands": [
			{
				"command": "adra.generateCode",
				"title": "Generate Code"
			},
			{
				"command": "adra.openKnowledgeBase",
				"title": "Open Knowledge Base"
			}
		]
	},
	"scripts": {
		"vscode:prepublish": "npm run compile",
		"compile": "tsc -p ./",
		"pretest": "npm run compile && npm run lint",
		"lint": "eslint extension",
		"test": "vscode-test"
	},
	"devDependencies": {
		"@types/mocha": "^10.0.10",
		"@types/node": "22.x",
		"@types/vscode": "^1.120.0",
		"@vscode/test-cli": "^0.0.11",
		"@vscode/test-electron": "^2.5.2",
		"eslint": "^9.39.3",
		"typescript": "^5.9.3",
		"typescript-eslint": "^8.56.1"
	},
	"dependencies": {
		"axios": "^1.16.1",
		"dotenv": "^17.4.2"
	}
}
